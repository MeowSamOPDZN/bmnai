rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Site on/off switch — public read; only the owner writes.
    // The first signed-in user to claim via /adminp becomes the owner.
    match /site/config {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && ( !("ownerUid" in resource.data)
                         || resource.data.ownerUid == request.auth.uid );
    }

    // Each user's chats — only that user (same account = same chats on any device).
    match /users/{uid}/chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /messages/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
