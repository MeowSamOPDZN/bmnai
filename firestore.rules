rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Site on/off switch — public read; only the owner writes.
    // The first signed-in user to claim via /adminp becomes the owner.
    match /site/config {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && ( !("ownerUid" in resource.data)
                         || resource.data.ownerUid == request.auth.uid );
    }

    function isOwner() {
      return request.auth != null
        && get(/databases/$(database)/documents/site/config).data.ownerUid == request.auth.uid;
    }

    // Each user's own account flags (review submitted, applied popup seen) — only that user.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Reviews — users create their own (always pending); the owner reads all and applies.
    match /reviews/{reviewId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isOwner());
      allow update: if request.auth != null && isOwner();
    }

    // Each user's chats — only that user (same account = same chats on any device).
    match /users/{uid}/chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /messages/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
